{
  "language": "gdscript",
  "source_dirs": [
    "client/features",
    "client/systems",
    "client/autoload"
  ],
  "exclude_patterns": ["addons/*", "tests/*"],
  "test_command": "bash client/scripts/run_godot_tests.sh",
  "test_timeout_seconds": 120,
  "build_timeout_seconds": 120,
  "preset": "STANDARD",
  "threshold": 40,
  "workers": 1,
  "cache_dir": ".cerebro_cache_gdscript",
  "report_dir": ".cerebro_reports_gdscript"
}

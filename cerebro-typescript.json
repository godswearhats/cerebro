{
  "language": "typescript",
  "source_dirs": [
    "server/src/app/domain",
    "server/src/app/application",
    "server/src/app/routes",
    "server/src/app/infrastructure"
  ],
  "exclude_patterns": ["*.test.ts", "*.spec.ts", "index.ts"],
  "test_command": "bash --login -c 'source ~/.nvm/nvm.sh && nvm use default && cd server && npm test'",
  "test_timeout_seconds": 60,
  "build_timeout_seconds": 60,
  "preset": "STANDARD",
  "threshold": 40,
  "workers": 1,
  "cache_dir": ".cerebro_cache_typescript",
  "report_dir": ".cerebro_reports_typescript"
}
